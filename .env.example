# Copy to .env (or export in your shell). All values below are the defaults used when nothing is set.
PGHOST=localhost
PGPORT=5432
PGUSER=dealflow
PGPASSWORD=DealFlow@2026
PGDATABASE=dealflow360
PORT=4300
# set DF_RESET=1 for one start to drop + reseed the demo database (or run `npm run reset`)
# Hosted deployment (Render / Railway / Neon…): use one URL instead of the PG* variables — TLS switches on automatically
# DATABASE_URL=postgres://user:password@host:5432/dealflow360
# PGSSL=1            # force TLS on/off (auto-detected from DATABASE_URL)
# COOKIE_SECURE=1    # set on any HTTPS host
# PUBLIC_URL=https://dealflow360.onrender.com   # used in copied portal links (default: request origin)
