{
  "name": "dealflow360",
  "version": "2.0.0",
  "description": "DealFlow360 — An Intelligent, Self-Governing Sales Operations Platform (React + Node.js + PostgreSQL)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "client": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "build": "npm run build --prefix client",
    "reset": "node -e \"process.env.DF_RESET=1; require('./src/db.js').init().then(()=>{console.log('database reset + reseeded');process.exit(0)}).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "test": "node test-e2e.js",
    "test:fresh": "npm run reset && npm test",
    "setup": "npm install && npm install --prefix client --include=dev && npm run client:build"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0"
  }
}
